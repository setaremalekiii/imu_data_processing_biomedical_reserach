{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "projectName": "ICM-20948_imu_reading",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        },
        {
            "type": "jlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch JLink GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        },
                {
            "name": "STlink launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/ICM-20948_imu_reading.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stutil",
            "device": "STM32H723ZG",
            "interface": "swd",
            "runToEntryPoint": "main", // else it starts at reset handler - not interested
            // "preLaunchTask": "Build all", // configured in tasks.json
            // "preLaunchCommands": ["Build all"], // you can execute command instead of task
            "svdFile": "", // Include svd to watch device peripherals
            "swoConfig": {} // currently (v1.7.0) not supported
        },
        {
            "name": "STlink attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/ICM-20948_imu_reading.elf",
            "request": "attach",
            "type": "cortex-debug",
            "showDevDebugOutput": "vscode",
            "servertype": "stutil",
            "device": "STM32H723ZG",
            "interface": "swd",
            "runToEntryPoint": "main", // else it starts at reset handler - not interested
            // "preLaunchTask": "Build all", // configured in tasks.json
            // "preLaunchCommands": ["Build all"], // you can execute command instead of task
            "svdFile": "", // Include svd to watch device peripherals
            "swoConfig": {} // currently (v1.7.0) not supported
        },

    {
      "name": "Debug (OpenOCD + ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "executable": "${workspaceRoot}/build\\Debug\\ICM-new-proj.elf",
      "servertype": "openocd",
      "cwd": "${workspaceRoot}",
    //   "cortex-debug.openocdPath": "C:\\xpack-openocd-0.12.0-7\\bin",

      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32h7x.cfg"
      ],

      "openOCDLaunchCommands": [
  "gdb_port 50000",
  "adapter speed 500",
  "reset_config srst_only connect_assert_srst",
  "init",
  "sleep 500",           // give OpenOCD a tiny pause
  "targets",
  "reset halt"
      ],
"postLaunchCommands": [
  "monitor reset halt"
],

      //"runToEntryPoint": "main",

      "svdFile": "",         // optional, if you have an SVD
      "showDevDebugOutput": "both"
    },

    ]
}